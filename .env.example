# ── Frontend (Vite) ────────────────────────────────────────────
# Copia este archivo a `.env` y ajusta los valores. `.env` NO se sube a git.
VITE_API_BASE_URL=http://localhost:5196/api

# ── Docker Compose (PostgreSQL + backend) ──────────────────────
# Define aquí tus valores locales. Nunca subas el `.env` real a git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=Sub_33

# ── Backend (.NET) ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
JWT_KEY=CHANGE_ME
JWT_ISSUER=Backend_Sub33
JWT_AUDIENCE=Backend_Sub33_Client
OTP_SECRET=CHANGE_ME
CORS_ORIGIN=http://localhost:8080

# ── SMTP (recuperación de contraseña) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=33a Compania CVB
