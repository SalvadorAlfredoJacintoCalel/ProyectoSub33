      "title": { "fontFamily": "inherit", "fontSize": 10, "bold": true, "align": "center", "valign": "middle" },
      "label": { "fontSize": 7, "bold": true, "align": "right", "valign": "middle", "border": "1px solid #000", "fill": "#f2f2f2" },
