    "calculations": {
      "runningTotal": "totalAnterior - haber (inicia en haberInicial)",
      "sumHaber": "SUM(tableBody[].haber)",
      "sumSaldo": "haberInicial - sumHaber",
      "sumTotalCupones": "SUM(tableBody[].totalCupones)",
      "monthlyBalance": "haberInicial - sumHaber"
    },
    "validation": {
      "fecha": { "pattern": "DD/MM/YYYY", "required": false },
      "anio": { "min": 2020, "max": 2030, "required": true },
      "mes": { "required": true },
      "currency": { "decimals": 2, "min": 0 },
      "decimal": { "decimals": 2, "min": 0 }
